

# Build artifacts (will be rebuilt)
.next/
out/
dist/
build/
*.tsbuildinfo

# Node modules (will be installed fresh)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE files
.idea/
.vscode/
*.swp
*.swo
*.sublime-*

# Version control
.git/
.gitignore
.gitattributes

# Documentation
*.md
README*
CHANGELOG*

# Test files
**/*.test.*
**/*.spec.*
__tests__/
coverage/
.nyc_output/

# Environment files (use docker-compose env vars)
.env*
!.env.example

# Temporary files
*.tmp
*.log
*.cache
.turbo/

# Other
.DS_Store
*.bak
*.backup
*.patch





